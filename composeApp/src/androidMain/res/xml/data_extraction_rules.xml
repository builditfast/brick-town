<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up: the same exclusion as backup_rules.xml, for both cloud
     backup and a device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_tokens.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_tokens.xml" />
    </device-transfer>
</data-extraction-rules>
